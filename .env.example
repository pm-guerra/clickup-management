# Copy to .env for local runs (git-ignored). On Railway, set these as service variables instead.
CLICKUP_CLIENT_ID=
CLICKUP_CLIENT_SECRET=
CLICKUP_WORKSPACE_ID=
# Public URL of this service, e.g. https://clickup-management.up.railway.app (or an ngrok URL locally)
APP_BASE_URL=http://localhost:8080
# Defaults to ${APP_BASE_URL}/clickup/oauth/callback; must match the redirect URL registered in the ClickUp app
CLICKUP_REDIRECT_URI=
# openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=
# openssl rand -hex 24 — sent as X-Admin-Key to /admin/** endpoints
ADMIN_API_KEY=
# JSON {"childFieldId":"parentFieldId"}
CLICKUP_CUSTOM_FIELD_MAPPINGS={}
# Optional: custom task type id of "Bug"
CLICKUP_BUG_CUSTOM_ITEM_ID=
